{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    // type errors in the ide without forcing jsdoc on every parameter
    "noImplicitAny": false,
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
